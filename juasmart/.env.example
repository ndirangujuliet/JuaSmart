# Africa's Talking credentials (sandbox or live)
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SHORTCODE=your_sms_shortcode_or_alphanumeric_id

# If true (default), SMS is only logged to console instead of actually sent.
# Set to false once you have real Africa's Talking credentials.
SMS_DRY_RUN=true

# Flask
PORT=5000
