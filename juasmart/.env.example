# Africa's Talking sandbox (demo) — same pattern as SokoSure
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
# Sandbox 2-way SMS shortcode from AT dashboard (required for replies)
AT_SHORTCODE=your_sms_shortcode

# false = actually send via AT (needed for simulator demo)
# true  = only log to console /sms_logs.db
SMS_DRY_RUN=false

# Flask
PORT=5000
